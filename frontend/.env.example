# Where the Quarkus app runs; /api/* is forwarded there
BACKEND_URL=http://localhost:8080

# OIDC provider for signing in (the defaults suit the backend's dev-mode Keycloak).
# Register <APP_URL>/auth/callback as a redirect URI for the client, and <APP_URL>/* as a post-logout redirect URI.
OIDC_ISSUER=http://localhost:8180/realms/quarkus
OIDC_CLIENT_ID=recipetool
# For a confidential client; dev-mode Keycloak's is "secret"
OIDC_CLIENT_SECRET=
OIDC_SCOPE=openid
# This app's public URL, when it runs behind a proxy (default: the request's origin)
APP_URL=
